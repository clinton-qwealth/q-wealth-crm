, "type": "text", "marks": [{"type": "em"}]}]}]}]}, {"type": "tableRow", "attrs": {"localId": "c4c640d88d3f"}, "content": [{"type": "tableCell", "attrs": {"colspan": 1, "rowspan": 1, "colwidth": [84], "localId": "b9613b6bb3fa"}, "content": [{"type": "paragraph", "attrs": {"localId": "3e505046a146"}}]}, {"type": "tableCell", "attrs": {"colspan": 5, "rowspan": 1, "colwidth": [235, 160, 160, 160, 160], "localId": "7714ddf205f0"}, "content": [{"type": "paragraph", "attrs": {"localId": "522a627ede13"}, "content": [{"text": "A prospect can organise an appoint from two options. ", "type": "text"}]}, {"type": "paragraph", "attrs": {"localId": "be3fa561e9a2"}, "content": [{"text": "1) via the website on the home page using the make booking page or; ", "type": "text"}]}, {"type": "paragraph", "attrs": {"localId": "512fd43bc5e8"}, "content": [{"text": "2) Direct contact with Q Wealth and client services making the booking using Calendly or the advisers outlook calendar. ", "type": "text"}, {"text": "The preferred method is directly on the Calendly platform. ", "type": "text", "marks": [{"type": "em"}]}, {"type": "hardBreak"}, {"type": "hardBreak"}, {"text": "Each Adviser has a personal appointments link - ", "type": "text"}, {"type": "hardBreak"}, {"text": "- ", "type": "text"}, {"text": "Simone Du Chesne: ", "type": "text", "marks": [{"type": "strong"}]}, {"text": "(to be added)", "type": "text"}, {"type": "hardBreak"}, {"text": "- ", "type": "text"}, {"text": "Huy Luu:", "type": "text", "marks": [{"type": "strong"}]}, {"text": " (to be added)", "type": "text"}, {"type": "hardBreak"}, {"text": "- ", "type": "text"}, {"text": "Chris Du Chesne: ", "type": "text", "marks": [{"type": "strong"}]}, {"text": "(to be added)", "type": "text"}]}, {"type": "paragraph", "attrs": {"localId": "f4a353d78f35"}, "content": [{"text": "The general booking page is at ", "type": "text"}, {"text": "qwealth.com.au", "type": "text", "marks": [{"type": "link", "attrs": {"href": "http://qwealth.com.au"}}]}, {"text": " ", "type": "text"}]}, {"type": "paragraph", "attrs": {"localId": "1ddbfd04d283"}}]}]}, {"type": "tableRow", "attrs": {"localId": "a2ec1689d058"}, "content": [{"type": "tableCell", "attrs": {"colspan": 1, "background": "#deebff", "rowspan": 1, "colwidth": [84], "localId": "ab90c8642b65"}, "content": [{"type": "paragraph", "attrs": {"localId": "32abb5a9bc3c"}, "content": [{"text": "2", "type": "text"}]}]}, {"type": "tableCell", "attrs": {"colspan": 1, "background": "#deebff", "rowspan": 1, "colwidth": [235], "localId": "e01e1c63eb70"}, "content": [{"type": "paragraph", "attrs": {"localId": "1c3116244c94"}, "content": [{"text": "Client added into CRM as Prospect", "type": "text", "marks": [{"type": "strong"}, {"type": "em"}]}]}]}, {"type": "tableCell", "attrs": {"colspan": 1, "background": "#deebff", "rowspan": 1, "colwidth": [160], "localId": "12cc01262b0c"}, "content": [{"type": "paragraph", "attrs": {"localId": "21dd14fccdd9"}, "content": [{"text": "When the appointment is made.", "type": "text", "marks": [{"type": "em"}]}]}]}, {"type": "tableCell", "attrs": {"colspan": 1, "background": "#deebff", "rowspan": 1, "colwidth": [160], "localId": "f3f61ed8ae68"}, "content": [{"type": "paragraph", "attrs": {"localId": "edd1f90b5acd"}, "content": [{"text": "Automated by Calendly", "type": "text", "marks": [{"type": "em"}]}]}]}, {"type": "tableCell", "attrs": {"colspan": 1, "background": "#deebff", "rowspan": 1, "colwidth": [160], "localId": "6e34807eb4c2"}, "content": [{"type": "paragraph", "attrs": {"localId": "28c1441e77f3"}, "content": [{"text": "Calendly", "type": "text", "marks": [{"type": "em"}]}]}]}, {"type": "tableCell", "attrs": {"colspan": 1, "background": "#deebff", "rowspan": 1, "colwidth": [160], "localId": "447a161ab3c4"}, "content": [{"type": "paragraph", "attrs": {"localId": "21552439c82d"}, "content": [{"text": "Client record is created and visible.", "type": "text", "marks": [{"type": "em"}]}]}]}]}, {"type": "tableRow", "attrs": {"localId": "9ea66b22b07d"}, "content": [{"type": "tableCell", "attrs": {"colspan": 1, "rowspan": 1, "colwidth": [84], "localId": "7d297d6ee0e0"}, "content": [{"type": "paragraph", "attrs": {"localId": "a0facf6fc474"}}]}, {"type": "tableCell", "attrs": {"colspan": 5, "rowspan": 1, "colwidth": [235, 160, 160, 160, 160], "localId": "cd8985dd8b65"}, "content": [{"type": "paragraph", "attrs": {"localId": "73074a8f6c7d"}, "content": [{"text": "Calendly is integrated with the Q Wealth CRM. When the appointment is made, this triggers Calendly to add the prospect into the CRM database. Asking Claude for a list of the most recent prospects will determine if the newly added prospect exists. ", "type": "text"}]}, {"type": "paragraph", "attrs": {"localId": "6c615eae0687"}}]}]}, {"type": "tableRow", "attrs": {"localId": "ee743a86ec54"}, "content": [{"type": "tableCell", "attrs": {"colspan": 1, "background": "#deebff", "rowspan": 1, "colwidth": [84], "localId": "a1d92abbb3e7"}, "content": [{"type": "paragraph", "attrs": {"localId": "a623ecfbedf6"}, "content": [{"text": "3", "type": "text"}]}]}, {"type": "tableCell", "attrs": {"colspan": 1, "background": "#deebff", "rowspan": 1, "colwidth": [235], "localId": "66f4a763394f"}, "content": [{"type": "paragraph", "attrs": {"localId": "6c2c859d1d18"}, "content": [{"text": "Confirmation to Prospect and request to complete Snapshot.", "type": "text", "marks": [{"type": "strong"}, {"type": "em"}]}]}]}, {"type": "tableCell", "attrs": {"colspan": 1, "background": "#deebff", "rowspan": 1, "colwidth": [160], "localId": "ed43ffdf6c21"}, "content": [{"type": "paragraph", "attrs": {"localId": "ad75cf49a1e2"}, "content": [{"text": "After appointment is made.", "type": "text", "marks": [{"type": "em"}]}]}]}, {"type": "tableCell", "attrs": {"colspan": 1, "background": "#deebff", "rowspan": 1, "colwidth": [160], "localId": "ef02dad40c8e"}, "content": [{"type": "paragraph", "attrs": {"localId": "f67f876e46fc"}, "content": [{"text": "Automated by Calendly", "ty