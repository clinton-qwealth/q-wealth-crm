ype": "paragraph", "attrs": {"localId": "32675882ad6c"}, "content": [{"text": "Provision of FSG and Privacy Policy", "type": "text", "marks": [{"type": "strong"}]}]}]}, {"type": "tableCell", "attrs": {"colspan": 1, "background": "#deebff", "rowspan": 1, "colwidth": [160], "localId": "fc145952b884"}, "content": [{"type": "paragraph", "attrs": {"localId": "216244596187"}, "content": [{"text": "After appointment is made", "type": "text"}]}]}, {"type": "tableCell", "attrs": {"colspan": 1, "background": "#deebff", "rowspan": 1, "colwidth": [160], "localId": "fabbebf7482c"}, "content": [{"type": "paragraph", "attrs": {"localId": "92c81e7dbedc"}, "content": [{"text": "Automated by Calendly", "type": "text", "marks": [{"type": "em"}]}]}]}, {"type": "tableCell", "attrs": {"colspan": 1, "background": "#deebff", "rowspan": 1, "colwidth": [160], "localId": "9e327a49d334"}, "content": [{"type": "paragraph", "attrs": {"localId": "d1bdfb03ece3"}, "content": [{"text": "Calendly", "type": "text"}]}]}, {"type": "tableCell", "attrs": {"colspan": 1, "background": "#deebff", "rowspan": 1, "colwidth": [160], "localId": "1d539d9b4dbc"}, "content": [{"type": "paragraph", "attrs": {"localId": "771a785a315d"}, "content": [{"text": "Email Confirmation and email log in Calendly", "type": "text"}]}]}]}, {"type": "tableRow", "attrs": {"localId": "97adac97c6dd"}, "content": [{"type": "tableCell", "attrs": {"colspan": 1, "rowspan": 1, "colwidth": [84], "localId": "d4bd8bbb7e0d"}, "content": [{"type": "paragraph", "attrs": {"localId": "bef2531422b7"}}]}, {"type": "tableCell", "attrs": {"colspan": 5, "rowspan": 1, "colwidth": [235, 160, 160, 160, 160], "localId": "9a24946ed185"}, "content": [{"type": "paragraph", "attrs": {"localId": "60e0a9cfbeca"}, "content": [{"text": "Email is sent to the prospect that includes a link to the Financial Services Guide and the Privacy Policy. These are both public documents. Within the email there is also reference to these documents within the MyProsperity App. ", "type": "text"}]}, {"type": "paragraph", "attrs": {"localId": "998855e5de71"}}]}]}, {"type": "tableRow", "attrs": {"localId": "fa3164a7c83d"}, "content": [{"type": "tableCell", "attrs": {"colspan": 1, "background": "#deebff", "rowspan": 1, "colwidth": [84], "localId": "894708e93c79"}, "content": [{"type": "paragraph", "attrs": {"localId": "e0380b306c94"}, "content": [{"text": "5.", "type": "text"}]}]}, {"type": "tableCell", "attrs": {"colspan": 1, "background": "#deebff", "rowspan": 1, "colwidth": [235], "localId": "5db77d35dcdd"}, "content": [{"type": "paragraph", "attrs": {"localId": "0052bd1174ff"}, "content": [{"text": "Set client folder up in Sharepoint", "type": "text", "marks": [{"type": "strong"}]}, {"text": " ", "type": "text"}]}]}, {"type": "tableCell", "attrs": {"colspan": 1, "background": "#deebff", "rowspan": 1, "colwidth": [160], "localId": "f7d353561be8"}, "content": [{"type": "paragraph", "attrs": {"localId": "850ed00bc78d"}, "content": [{"text": "After appointment is made.", "type": "text"}]}]}, {"type": "tableCell", "attrs": {"colspan": 1, "background": "#deebff", "rowspan": 1, "colwidth": [160], "localId": "514c2654b25b"}, "content": [{"type": "paragraph", "attrs": {"localId": "6b4b4549c4ee"}, "content": [{"text": "Client Services", "type": "text", "marks": [{"type": "em"}]}]}]}, {"type": "tableCell", "attrs": {"colspan": 1, "background": "#deebff", "rowspan": 1, "colwidth": [160], "localId": "29b2b55e3b84"}, "content": [{"type": "paragraph", "attrs": {"localId": "ad6ef4cc9b1b"}, "content": [{"text": "Sharepoint", "type": "text"}]}]}, {"type": "tableCell", "attrs": {"colspan": 1, "background": "#deebff", "rowspan": 1, "colwidth": [160], "localId": "5ff9eb9326d2"}, "content": [{"type": "paragraph", "attrs": {"localId": "1dc97a012623"}, "content": [{"text": "The folder is visible in the directory and accessible. ", "type": "text"}]}]}]}, {"type": "tableRow", "attrs": {"localId": "50c9f17c81d0"}, "content": [{"type": "tableCell", "attrs": {"colspan"