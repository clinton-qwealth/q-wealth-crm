"type": "tableCell", "attrs": {"colspan": 1, "background": "#deebff", "rowspan": 1, "colwidth": [160], "localId": "4409af2ce57f"}, "content": [{"type": "paragraph", "attrs": {"localId": "a7efb952c6ff"}, "content": [{"text": "Calendly + Twillio", "type": "text"}]}]}, {"type": "tableCell", "attrs": {"colspan": 1, "background": "#deebff", "rowspan": 1, "colwidth": [160], "localId": "8e415f89fcd3"}, "content": [{"type": "paragraph", "attrs": {"localId": "47f088c461d5"}, "content": [{"text": "Email confirmation is sent to both prospect and adviser. ", "type": "text"}]}]}]}, {"type": "tableRow", "attrs": {"localId": "39ac11a6c775"}, "content": [{"type": "tableCell", "attrs": {"colspan": 1, "rowspan": 1, "colwidth": [84], "localId": "ec85711d7217"}, "content": [{"type": "paragraph", "attrs": {"localId": "33ee85cf6e31"}}]}, {"type": "tableCell", "attrs": {"colspan": 5, "rowspan": 1, "colwidth": [235, 160, 160, 160, 160], "localId": "d0d5d47a2bfe"}, "content": [{"type": "paragraph", "attrs": {"localId": "0d00e3b4a1f7"}, "content": [{"text": "Meeting reminder is emailed or SMS from Calendly to the prospect letting them know their appointment is ‘tomorrow’. This is to ensure the prospect does not forget the appointment. At the same time a reminder is provided to the adviser, so the adviser can be adequately prepared for the meeting. ", "type": "text"}]}, {"type": "paragraph", "attrs": {"localId": "c428108c17ea"}}]}]}, {"type": "tableRow", "attrs": {"localId": "0c7aa0faeef5"}, "content": [{"type": "tableCell", "attrs": {"colspan": 1, "background": "#deebff", "rowspan": 1, "colwidth": [84], "localId": "1ae955271dde"}, "content": [{"type": "paragraph", "attrs": {"localId": "e01ab4030403"}, "content": [{"text": "7.", "type": "text"}]}]}, {"type": "tableCell", "attrs": {"colspan": 1, "background": "#deebff", "rowspan": 1, "colwidth": [235], "localId": "8460ee7f238e"}, "content": [{"type": "paragraph", "attrs": {"localId": "73daf0aeeb23"}, "content": [{"text": "Prepare the first meeting pack", "type": "text", "marks": [{"type": "strong"}]}]}]}, {"type": "tableCell", "attrs": {"colspan": 1, "background": "#deebff", "rowspan": 1, "colwidth": [160], "localId": "6f0dba698b54"}, "content": [{"type": "paragraph", "attrs": {"localId": "8782d91ae2e3"}, "content": [{"text": "at least 1 day before the first meeting", "type": "text"}]}]}, {"type": "tableCell", "attrs": {"colspan": 1, "background": "#deebff", "rowspan": 1, "colwidth": [160], "localId": "0789f3da3c91"}, "content": [{"type": "paragraph", "attrs": {"localId": "4b06a483f2d1"}, "content": [{"text": "Client Services", "type": "text"}]}]}, {"type": "tableCell", "attrs": {"colspan": 1, "background": "#deebff", "rowspan": 1, "colwidth": [160], "localId": "d78427a97a6c"}, "content": [{"type": "paragraph", "attrs": {"localId": "7486470db237"}, "content": [{"text": "N/A", "type": "text"}]}]}, {"type": "tableCell", "attrs": {"colspan": 1, "background": "#deebff", "rowspan": 1, "colwidth": [160], "localId": "f9eb929d1273"}, "content": [{"type": "paragraph", "attrs": {"localId": "4e5db13a4b92"}, "content": [{"text": "Checklist is completed for the first meeting pack. ", "type": "text"}]}]}]}, {"type": "tableRow", "attrs": {"localId": "1ac9c5424da3"}, "content": [{"type": "tableCell", "attrs": {"colspan": 1, "rowspan": 1, "colwidth": [84], "localId": "d1128e5ea911"}, "content": [{"type": "paragraph", "attrs": {"localId": "29e3723f6421"}}]}, {"type": "tableCell", "attrs": {"colspan": 5, "rowspan": 1, "colwidth": [235, 160, 160, 160, 160], "localId": "83c6f21e5ec1"}, "content": [{"type": "paragraph", "attrs": {"localId": "7cee260a9930"}, "content": [{"text": "The Client Services team prepares the first meeting pack for the adviser to present in the meeting.", "type": "text"}]}, {"type": "taskList", "attrs": {"localId": "ba343e6c-6a9b-43e6-b1aa-57d141f9da85"}, "content": [{"type": "taskItem", "attrs": {"state": "TODO", "localId": "257b71d6-17f5-4ef0-b804-484a02805594"}, "content": [{"text": "Risk Profile", 