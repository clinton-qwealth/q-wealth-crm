{"id": "13139969", "title": "'How to' Procedures Template", "version": 1, "body": {"type": "doc", "content": [{"type": "paragraph", "content": [{"text": "This section holds Q Wealth's ", "type": "text"}, {"text": "Standard Operating Procedures (SOPs)", "type": "text", "marks": [{"type": "strong"}]}, {"text": " — step-by-step guides for how we carry out our recurring operational processes.", "type": "text"}]}, {"type": "panel", "attrs": {"panelType": "info"}, "content": [{"type": "paragraph", "content": [{"text": "Creating a new procedure?", "type": "text", "marks": [{"type": "strong"}]}, {"text": " Start from the ", "type": "text"}, {"text": "SOP Template (Copy Me)", "type": "text", "marks": [{"type": "strong"}]}, {"text": " page below. Use the ", "type": "text"}, {"text": "•••", "type": "text", "marks": [{"type": "strong"}]}, {"text": " menu on that page and select ", "type": "text"}, {"text": "Copy", "type": "text", "marks": [{"type": "strong"}]}, {"text": ", then rename and fill in your procedure. This keeps every SOP consistent.", "type": "text"}]}]}, {"type": "heading", "attrs": {"level": 2}, "content": [{"text": "Procedures in this section", "type": "text"}]}, {"type": "paragraph", "content": [{"text": "Published procedures will appear as child pages here. Use the panel above to add a new one.", "type": "text"}]}, {"type": "heading", "attrs": {"level": 2}, "content": [{"text": "Conventions", "type": "text"}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"text": "Owner", "type": "text", "marks": [{"type": "strong"}]}, {"text": " maintains the accuracy of each procedure; the ", "type": "text"}, {"text": "Approver", "type": "text", "marks": [{"type": "strong"}]}, {"text": " signs off on it.", "type": "text"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"text": "Every procedure carries a ", "type": "text"}, {"text": "version history", "type": "text", "marks": [{"type": "strong"}]}, {"text": ", an ", "type": "text"}, {"text": "effective date", "type": "text", "marks": [{"type": "strong"}]}, {"text": " and a ", "type": "text"}, {"text": "next review date", "type": "text", "marks": [{"type": "strong"}]}, {"text": ".", "type": "text"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"text": "Review each procedure at least annually, or sooner if the underlying process changes.", "type": "text"}]}]}]}], "version": 1}}